# Copier en .env et adapter.
DATABASE_URL="postgresql://apex:apex@localhost:5432/apex?schema=public"
# Générer avec : npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Mailpit en local (docker compose) ; serveur SMTP réel en production
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="APEX <no-reply@apex.local>"
# Requis hors Vercel (Docker, Azure…) pour qu'Auth.js accepte l'hôte de la requête
AUTH_TRUST_HOST="true"
